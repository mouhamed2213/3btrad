# Application
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_key_btp_2026_change_in_production
JWT_EXPIRES_IN=1d

# Base de Données PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/btp_db?schema=public"

# Redis (pour BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Stockage S3 Compatible (Cloudflare R2 / DigitalOcean Spaces / AWS)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=btp-assets